.venv/
__pycache__/
.env
data/raw/
data/labeled
data/clean/
tracker/
archive/

# runs/ is split by whether a file can be rebuilt: runs/regen/ can, runs/keep/ cannot,
# and runs/README.md is the index. Both halves are versioned -- the split is about what
# is safe to DELETE, not about what is worth committing -- so this list is only about
# size. The heavy binaries (fitted models, per-row scores) stay out at tens of MB each;
# `train.py` rebuilds them on demand. Everything else in runs/ is small and is evidence
# for a claim made in code or in OPERATING_POINTS.md, so it travels with the claim.
runs/**/*.joblib
runs/**/*.pkl
runs/**/*.csv
runs/**/*.npy
runs/**/*.parquet

# labeled_raw/ splits the same way. The per-session labelled CSVs are a few GB and
# `label_all.py` rebuilds them from data/raw on demand; the sweep report, the summary
# and the abstention ledger are the record of what this corpus labels at a given
# threshold -- small, and evidence for claims made elsewhere. Those stay.
labeled_raw/*/